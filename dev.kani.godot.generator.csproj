<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <!-- This project can be consumed via relative ProjectReference from other repos.
             When referenced from inside a repo that turns on central package management, it must not
             inherit that repo's Directory.Packages.props; it manages its own package versions inline. -->
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>

        <RootNamespace>GenUtilities</RootNamespace>
        <PackageId>Dev.Kani.Godot.Generator</PackageId>
        <AssemblyName>Generators</AssemblyName>
    </PropertyGroup>

    <!-- This project lives at the repository root, so the SDK's default compile
         glob is `**/*.cs` for the entire repo, minus only bin/ and obj/.
         Anything that drops C# anywhere under the root therefore becomes part of
         *this* compilation.

         `smoke/` is exactly that: the CI throwaway consumer project (see
         .gitlab-ci.yml, package:smoke) writes generated Godot code into
         smoke/generated/. Left globbed in, `dotnet build`/`dotnet pack` at the
         root tries to compile Godot-dependent code inside a netstandard2.1
         analyzer project that has no Godot reference, and dies with a wall of
         CS0246 pointing at files this project does not own. That happens in CI
         whenever a later job downloads package:smoke's artifacts, and locally
         to anyone who runs the smoke flow by hand.

         .gitignore does not help here — it governs git, not MSBuild globs. -->
    <ItemGroup>
        <Compile Remove="smoke/**" />
        <None Remove="smoke/**" />
        <Compile Remove="pkg/**" />
        <None Remove="pkg/**" />
    </ItemGroup>

    <!-- ===================================================================
         NuGet packaging — a Roslyn analyzer package, not a library package
         ===================================================================
         A source generator ships as an *analyzer asset*: the consumer's
         compiler loads the DLL from analyzers/dotnet/cs, and nothing is ever
         referenced at runtime. Hence:

           IncludeBuildOutput=false      keep Generators.dll out of lib/, which
                                         is what would make it a normal runtime
                                         reference (and, for netstandard2.1,
                                         drag a bogus target framework into
                                         every consumer).
           SuppressDependenciesWhenPacking  analyzers get no dependency
                                         resolution — a <dependency> in the
                                         nuspec would be silently ignored at
                                         analyzer load time and just confuse
                                         consumers. The Microsoft.CodeAnalysis.*
                                         references below are compile-time only
                                         (the host compiler supplies them at
                                         run time), so there is nothing real to
                                         declare.

         The <None Pack="true"> item is what actually puts the DLL in the
         package. `dotnet pack` builds before packing, so $(OutputPath) is
         populated by the time this is evaluated.
    -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <!-- DevelopmentDependency=true writes <developmentDependency>true</developmentDependency>
             into the nuspec, and a PackageReference consumer honours that as an implicit
             PrivateAssets=all: the analyzer is loaded by that project's own compiler and does
             not flow on to anything consuming *it*. Without the flag the package is silently
             re-exported by every consumer that forgets to write the metadata by hand.

             PrivateAssets is the only asset knob that matters for this package. The usual
             six-tag IncludeAssets incantation exists to drop `compile`, and IncludeBuildOutput
             above already means there is no lib/ to compile against. -->
        <DevelopmentDependency>true</DevelopmentDependency>

        <!-- Local/dev fallback only. CI always overrides this with -p:Version=
             from the release tag, so this number is not the source of truth. -->
        <Version>0.1.0</Version>

        <Authors>kanimaru</Authors>
        <Description>Roslyn source generators for Godot 4 C#: typed unique-name nodes, scene, autoload, input action and group access, resource tables, singletons, node metadata, logging and multiplayer sync.</Description>
        <PackageTags>godot;godot4;gamedev;source-generator;roslyn;analyzer;codegen</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/kanimaru/lazy-o-godot</PackageProjectUrl>
        <PackageReadmeFile>Readme.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/kanimaru/lazy-o-godot</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
        <!-- Shown on the package page. Its links are absolute so they work there too. -->
        <None Include="Readme.md" Pack="true" PackagePath="/"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Release tracking for RxSchedulerAnalyzer (RS2008). -->
        <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    </ItemGroup>

    <ItemGroup>
        <!-- PrivateAssets=all on all of these: the compiler host provides the
             Roslyn assemblies at analyzer load time. Shipping or declaring them
             would at best be dead weight and at worst load the wrong version. -->
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" PrivateAssets="all"/>
    </ItemGroup>
</Project>
